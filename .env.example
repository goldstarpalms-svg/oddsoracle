# ---- Live market odds (optional) ----
# Add a free key at https://the-odds-api.com to enable live market odds on
# top of the local real-data feed (the site works without it).
THE_ODDS_API_KEY=

# ---- Telegram morning ticket (optional) ----
# Used by backend/app/refresh_forebet.py (GitHub Actions cron) to DM the day's
# refreshed pick counts. Get a bot from @BotFather, then set your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- AI-written analysis (optional) ----
# When set to true, we ask Gemini to rewrite each pick's analysis paragraph for
# richer SEO copy. Turn off to save tokens / avoid rate limits.
AI_WRITE=false
GEMINI_API_KEY=

# ---- Output ----
# Human label for the "source" indicator when running live.
NEXT_PUBLIC_LIVE=false
NEXT_PUBLIC_SITE_URL=https://oddsoracle-xi.vercel.app
