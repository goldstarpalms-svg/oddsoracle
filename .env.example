# ---- Live predictions (optional) ----
# Without these the site runs on the curated editorial picks (works out of the box).
# Add a free key at https://the-odds-api.com to enable real, data-backed picks.
THE_ODDS_API_KEY=

# ---- AI-written analysis (optional) ----
# When set to true, we ask Gemini to rewrite each pick's analysis paragraph for
# richer SEO copy. Turn off to save tokens / avoid rate limits.
AI_WRITE=false
GEMINI_API_KEY=

# ---- Output ----
# Human label for the "source" indicator when running live.
NEXT_PUBLIC_LIVE=false
NEXT_PUBLIC_SITE_URL=https://oddsoracle-xi.vercel.app
